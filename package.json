{
  "name": "audit-scanner",
  "version": "1.6.0",
  "private": true,
  "description": "Nightly CVE-Audit-Scanner: GitHub-Repos scannen (trivy), Advisories matchen, Telegram-Report, optionale Auto-Fix-PRs.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "scan": "npm run build && node dist/index.js scan",
    "inventory": "node dist/index.js inventory",
    "test-telegram": "node dist/index.js test-telegram",
    "state-test": "node dist/index.js state-test",
    "image-vulns-test": "node dist/index.js image-vulns-test",
    "image-freshness-test": "node dist/index.js image-freshness-test",
    "soaking-test": "node dist/index.js soaking-test"
  },
  "dependencies": {
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  }
}
